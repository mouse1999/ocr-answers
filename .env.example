# --- Question extraction (Gemini) ---
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-1.5-flash

# --- Answering model ---
# ANSWER_PROVIDER = "openai" or "grok"
ANSWER_PROVIDER=openai
ANSWER_MODEL=gpt-4o-mini

# Needed only if ANSWER_PROVIDER=openai
OPENAI_API_KEY=your_openai_api_key_here

# Needed only if ANSWER_PROVIDER=grok (x.ai)
GROK_API_KEY=your_grok_api_key_here

# --- CORS ---
# Comma-separated list of allowed frontend origins.
# Example: https://your-app.vercel.app,http://localhost:5500
FRONTEND_URL=https://your-app.vercel.app

# --- Optional ---
# Override the default "answer these questions" system prompt.
# DEFAULT_SYSTEM_PROMPT=You are ...

PORT=8080
